# Шаблон настроек. Скопируйте в .env и правьте под свою среду.
# Все параметры читаются с префиксом SUE_ — без него значение игнорируется.
# Файл .env исключён из репозитория и из образа: секреты в историю не попадают.

# --- окружение и журнал -------------------------------------------------------
SUE_APP_ENV=local
SUE_LOG_LEVEL=INFO
SUE_LOG_JSON=false

# --- хранилище ---------------------------------------------------------------
SUE_DATABASE_URL=sqlite:///./data/sue.db
# SUE_DATABASE_URL=postgresql+psycopg2://sue:sue@localhost:5432/sue

# --- обмен данными -----------------------------------------------------------
SUE_FIXTURES_DIR=./data/fixtures
SUE_SCHEMA_PATH=./schemas/1c_retail_exchange.schema.json
SUE_REPORTS_DIR=./data/reports
SUE_MAX_UPLOAD_BYTES=33554432
SUE_MAX_BATCH_DOCUMENTS=200000
SUE_MAX_ERRORS_PER_RUN=500
SUE_ETL_CHUNK_SIZE=5000
SUE_ALLOW_LOCAL_PATH_IMPORT=true
SUE_API_PAGE_SIZE=50
SUE_API_MAX_PAGE_SIZE=500

# Эмулятор выгрузки 1С (учебный HTTP-сервис, не живая база)
SUE_ENABLE_EMULATOR=true
SUE_EMULATOR_ALLOWED_HOSTS=127.0.0.1,localhost,::1

# --- контроль доступа --------------------------------------------------------
# Пустой ключ — барьер выключен (локальная демонстрация).
# Ключ для промышленного контура: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUE_API_KEY=
SUE_PROTECT_READ=false

# --- моделируемые параметры рентабельности -----------------------------------
SUE_OVERHEAD_RATE=0.12
SUE_DEFAULT_COST_RATIO=0.65
SUE_MARGIN_TARGET_PCT=28.0
SUE_MARGIN_WARN_PCT=27.0
