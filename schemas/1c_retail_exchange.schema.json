{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/1c_retail_exchange.schema.json",
  "title": "1C Retail File Exchange Batch v2.0",
  "description": "Контракт файлового обмена, структурно совместимый с объектами 1С:Розница (справочники «Магазины», «Номенклатура», документы «Отчёт о розничных продажах»/«Возврат товаров от покупателя»).",
  "type": "object",
  "required": ["meta", "stores", "products", "saleDocuments"],
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Идентификатор объекта в системе-источнике (аналог GUID ссылки 1С)."
    },
    "money": {
      "type": "number",
      "description": "Сумма в рублях. Точность — не более 2 знаков после запятой (проверяется правилами приёмника через Decimal: проверка multipleOf в JSON Schema выполняется над float и даёт ложные срабатывания)."
    },
    "quantity": {
      "type": "number",
      "description": "Количество. Точность — не более 3 знаков после запятой."
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": ["contractVersion", "exchangeId", "sourceSystem", "exportedAt", "configuration"],
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "type": "string",
          "enum": ["2.0"],
          "description": "Версия контракта обмена. Приёмник отклоняет неподдерживаемые версии."
        },
        "exchangeId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceSystem": { "const": "1C:Retail" },
        "configuration": { "type": "string", "minLength": 1 },
        "exportedAt": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "RUB" },
        "periodFrom": { "type": "string", "format": "date" },
        "periodTo": { "type": "string", "format": "date" },
        "comment": { "type": "string", "maxLength": 1000 }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "code", "name"],
        "additionalProperties": false,
        "properties": {
          "ref": { "$ref": "#/$defs/ref" },
          "code": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "city": { "type": "string", "maxLength": 128 },
          "format": {
            "type": "string",
            "maxLength": 64,
            "description": "Формат торговой точки (например, «у дома», «супермаркет»)."
          },
          "isActive": { "type": "boolean", "default": true }
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "sku", "name", "category"],
        "additionalProperties": false,
        "properties": {
          "ref": { "$ref": "#/$defs/ref" },
          "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "category": { "type": "string", "minLength": 1, "maxLength": 128 },
          "unit": { "type": "string", "maxLength": 16, "default": "шт" }
        }
      }
    },
    "saleDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "number", "date", "storeRef", "lines"],
        "additionalProperties": false,
        "properties": {
          "ref": { "$ref": "#/$defs/ref" },
          "number": { "type": "string", "minLength": 1, "maxLength": 64 },
          "date": { "type": "string", "format": "date" },
          "storeRef": { "$ref": "#/$defs/ref" },
          "documentType": {
            "type": "string",
            "enum": ["sale", "return"],
            "default": "sale",
            "description": "sale — реализация (Отчёт о розничных продажах), return — возврат товаров от покупателя. Суммы в строках всегда положительные; знак определяется типом документа."
          },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "RUB" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["ref", "productRef", "quantity", "amount"],
              "additionalProperties": false,
              "properties": {
                "ref": { "$ref": "#/$defs/ref" },
                "productRef": { "$ref": "#/$defs/ref" },
                "quantity": { "$ref": "#/$defs/quantity", "exclusiveMinimum": 0 },
                "amount": {
                  "$ref": "#/$defs/money",
                  "exclusiveMinimum": 0,
                  "description": "Сумма к оплате с учётом скидки. Именно она формирует выручку в СУЭ."
                },
                "discountAmount": {
                  "$ref": "#/$defs/money",
                  "minimum": 0,
                  "description": "Предоставленная скидка. Информационное поле: в выручку не входит, так как уже вычтена из amount."
                },
                "costAmount": {
                  "$ref": "#/$defs/money",
                  "minimum": 0,
                  "description": "Себестоимость из учётного контура (регистр «Себестоимость товаров»). Может отсутствовать — тогда показатель моделируется приёмником."
                }
              }
            }
          }
        }
      }
    }
  }
}
